+/* ===== DFM adb_enabled spoof hook (out-of-repo addition) ===== */
+#include <linux/moduleparam.h>
+#include <linux/slab.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+#include <linux/printk.h>
+#include <linux/spinlock.h>
+
+/* 0=off 1=log-match 2=patch 3=verbose */
+static int dfm_spoof_mode = 2;
+module_param(dfm_spoof_mode, int, 0644);
+static int dfm_uid = 10297;
+module_param(dfm_uid, int, 0644);
+static int dfm_reqs;
+module_param(dfm_reqs, int, 0444);
+static int dfm_matched;
+module_param(dfm_matched, int, 0444);
+static int dfm_patched;
+module_param(dfm_patched, int, 0444);
+
+static const u8 dfm_key_u16[] = {'a',0,'d',0,'b',0,'_',0,'e',0,'n',0,'a',0,'b',0,'l',0,'e',0,'d',0};
+static const u8 dfm_key_ascii[] = {'a','d','b','_','e','n','a','b','l','e','d'};
+static const u8 dfm_str_one[] = {0x01,0,0,0,'1',0};   /* UTF-16 string "1" */
+
+static int dfm_find(const u8 *h, int hl, const u8 *n, int nl)
+{
+	int i;
+	if (nl <= 0 || hl < nl) return -1;
+	for (i = 0; i <= hl - nl; i++)
+		if (!memcmp(h + i, n, nl)) return i;
+	return -1;
+}
+
+#define DFM_RING 256
+static int dfm_ring[DFM_RING];
+static int dfm_ring_head;
+static DEFINE_SPINLOCK(dfm_ring_lock);
+static void dfm_ring_add(int id)
+{
+	unsigned long f;
+	spin_lock_irqsave(&dfm_ring_lock, f);
+	dfm_ring[dfm_ring_head & (DFM_RING - 1)] = id;
+	dfm_ring_head++;
+	spin_unlock_irqrestore(&dfm_ring_lock, f);
+}
+static int dfm_ring_take(int id)
+{
+	int i, hit = 0;
+	unsigned long f;
+	if (!id) return 0;
+	spin_lock_irqsave(&dfm_ring_lock, f);
+	for (i = 0; i < DFM_RING; i++)
+		if (dfm_ring[i] == id) { dfm_ring[i] = 0; hit = 1; break; }
+	spin_unlock_irqrestore(&dfm_ring_lock, f);
+	return hit;
+}
+
+static int dfm_uid_of(struct binder_proc *p)
+{
+	kuid_t euid;
+	if (!p || !p->tsk) return -1;
+	rcu_read_lock();
+	euid = __task_cred(p->tsk)->euid;
+	rcu_read_unlock();
+	return from_kuid(&init_user_ns, euid);
+}
+
+static void dfm_adb_hook(int reply, struct binder_proc *proc,
+			 struct binder_proc *target_proc,
+			 struct binder_transaction *in_reply_to,
+			 struct binder_transaction *t)
+{
+	u8 *buf = NULL;
+	size_t len;
+
+	if (dfm_spoof_mode == 0 || !t || !t->buffer)
+		return;
+
+	if (!reply) {
+		/* request: sender=proc(dfm?), data in target_proc(SettingsProvider) alloc */
+		if (dfm_uid_of(proc) != dfm_uid || !target_proc)
+			return;
+		len = t->buffer->data_size;
+		if (len == 0 || len > 8192)
+			return;
+		buf = kmalloc(len, GFP_KERNEL);
+		if (!buf)
+			return;
+		if (binder_alloc_copy_from_buffer(&target_proc->alloc, buf, t->buffer, 0, len))
+			goto out;
+		if (dfm_find(buf, len, dfm_key_u16, sizeof(dfm_key_u16)) >= 0 ||
+		    dfm_find(buf, len, dfm_key_ascii, sizeof(dfm_key_ascii)) >= 0) {
+			dfm_ring_add(t->debug_id);
+			dfm_reqs++;
+			if (dfm_spoof_mode == 3)
+				pr_info("DFM_ADB req id=%d len=%zu\n", t->debug_id, len);
+		}
+		goto out;
+	}
+
+	/* reply: target=target_proc(dfm?), data in target_proc alloc */
+	if (dfm_uid_of(target_proc) != dfm_uid || !in_reply_to)
+		return;
+	if (!dfm_ring_take(in_reply_to->debug_id))
+		return;
+	dfm_matched++;
+
+	len = t->buffer->data_size;
+	if (len == 0 || len > 8192)
+		return;
+	buf = kmalloc(len, GFP_KERNEL);
+	if (!buf)
+		return;
+	if (binder_alloc_copy_from_buffer(&target_proc->alloc, buf, t->buffer, 0, len))
+		goto out;
+
+	if (dfm_spoof_mode == 1 || dfm_spoof_mode == 3) {
+		pr_info("DFM_ADB match id=%d rlen=%zu\n", in_reply_to->debug_id, len);
+		print_hex_dump(KERN_INFO, "DFM_ADB M ", DUMP_PREFIX_OFFSET, 16, 1,
+			       buf, len < 256 ? len : 256, false);
+		if (dfm_spoof_mode == 1)
+			goto out;
+	}
+
+	{
+		int p = dfm_find(buf, len, dfm_str_one, sizeof(dfm_str_one));
+		if (p >= 0) {
+			u8 zero = '0';
+			if (!binder_alloc_copy_to_buffer(&target_proc->alloc, t->buffer,
+							 p + 4, &zero, 1)) {
+				dfm_patched++;
+				pr_info("DFM_ADB patched id=%d off=%d\n",
+					in_reply_to->debug_id, p + 4);
+			}
+		}
+	}
+out:
+	kfree(buf);
+}
+/* ===== end DFM hook ===== */
 
