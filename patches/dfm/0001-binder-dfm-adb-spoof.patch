+/* ===== DFM adb_enabled spoof hook (out-of-repo addition) ===== */
+#include <linux/moduleparam.h>
+#include <linux/slab.h>
+#include <linux/cred.h>
+#include <linux/uidgid.h>
+#include <linux/printk.h>
+
+/* 0=off  1=observe(log only)  2=patch value '1'->'0'  */
+static int dfm_spoof_mode = 1;
+module_param(dfm_spoof_mode, int, 0644);
+MODULE_PARM_DESC(dfm_spoof_mode, "DFM adb_enabled spoof: 0 off, 1 observe, 2 patch");
+
+/* target app uid (com.proxima.dfm). change at runtime if reinstalled. */
+static int dfm_uid = 10297;
+module_param(dfm_uid, int, 0644);
+MODULE_PARM_DESC(dfm_uid, "uid whose adb_enabled reply is spoofed");
+
+static atomic_t dfm_hits = ATOMIC_INIT(0);
+
+/* UTF-16LE "adb_enabled" (Java Parcel strings are UTF-16LE) */
+static const u8 dfm_key_u16[] = {
+	'a',0,'d',0,'b',0,'_',0,'e',0,'n',0,'a',0,'b',0,'l',0,'e',0,'d',0
+};
+static const u8 dfm_key_ascii[] = { 'a','d','b','_','e','n','a','b','l','e','d' };
+
+static int dfm_find(const u8 *hay, int hlen, const u8 *needle, int nlen)
+{
+	int i;
+	if (nlen <= 0 || hlen < nlen)
+		return -1;
+	for (i = 0; i <= hlen - nlen; i++)
+		if (!memcmp(hay + i, needle, nlen))
+			return i;
+	return -1;
+}
+
+static void dfm_adb_hook(int reply, struct binder_proc *target_proc,
+			 struct binder_transaction *in_reply_to,
+			 struct binder_transaction *t)
+{
+	kuid_t euid;
+	int tuid, qpos = -1;
+	size_t rlen, qlen;
+	u8 *rbuf = NULL, *qbuf = NULL;
+
+	if (!reply || dfm_spoof_mode == 0)
+		return;
+	if (!target_proc || !target_proc->tsk || !t || !t->buffer)
+		return;
+
+	/* cheap gate: only dfm's replies */
+	rcu_read_lock();
+	euid = __task_cred(target_proc->tsk)->euid;
+	rcu_read_unlock();
+	tuid = from_kuid(&init_user_ns, euid);
+	if (tuid != dfm_uid)
+		return;
+
+	rlen = t->buffer->data_size;
+	if (rlen == 0 || rlen > 512)            /* settings reply is tiny */
+		return;
+
+	/* correlate with request: must mention adb_enabled */
+	if (in_reply_to && in_reply_to->buffer && in_reply_to->to_proc) {
+		qlen = in_reply_to->buffer->data_size;
+		if (qlen > 0 && qlen <= 2048) {
+			qbuf = kmalloc(qlen, GFP_KERNEL);
+			if (qbuf &&
+			    !binder_alloc_copy_from_buffer(&in_reply_to->to_proc->alloc,
+							   qbuf, in_reply_to->buffer,
+							   0, qlen)) {
+				qpos = dfm_find(qbuf, qlen, dfm_key_u16,
+						sizeof(dfm_key_u16));
+				if (qpos < 0)
+					qpos = dfm_find(qbuf, qlen, dfm_key_ascii,
+							sizeof(dfm_key_ascii));
+			}
+		}
+	}
+	if (qpos < 0)
+		goto out;   /* not an adb_enabled read */
+
+	rbuf = kmalloc(rlen, GFP_KERNEL);
+	if (!rbuf)
+		goto out;
+	if (binder_alloc_copy_from_buffer(&target_proc->alloc, rbuf, t->buffer,
+					  0, rlen))
+		goto out;
+
+	atomic_inc(&dfm_hits);
+
+	if (dfm_spoof_mode == 1) {
+		pr_info("DFM_ADB: hit#%d uid=%d rlen=%zu qpos=%d\n",
+			atomic_read(&dfm_hits), tuid, rlen, qpos);
+		print_hex_dump(KERN_INFO, "DFM_ADB REQ ", DUMP_PREFIX_OFFSET,
+			       16, 1, qbuf, qlen, false);
+		print_hex_dump(KERN_INFO, "DFM_ADB RPL ", DUMP_PREFIX_OFFSET,
+			       16, 1, rbuf, rlen, false);
+		goto out;
+	}
+
+	/* dfm_spoof_mode == 2: patch value '1'->'0'.
+	 * WARNING: value locator below is a FIRST CUT. Read mode-1 dmesg first
+	 * to confirm the exact value offset/encoding, then harden this. */
+	{
+		static const u8 one_u16[2]  = { '1', 0 };
+		static const u8 zero_u16[2] = { '0', 0 };
+		int p = dfm_find(rbuf, rlen, one_u16, sizeof(one_u16));
+
+		if (p >= 0 &&
+		    !binder_alloc_copy_to_buffer(&target_proc->alloc, t->buffer,
+						 p, (void *)zero_u16, 2))
+			pr_info("DFM_ADB: patched '1'->'0' at off=%d uid=%d\n",
+				p, tuid);
+	}
+out:
+	kfree(rbuf);
+	kfree(qbuf);
+}
+/* ===== end DFM hook ===== */
 
 static void binder_transaction(struct binder_proc *proc,
 			       struct binder_thread *thread,
@@ -3914,6 +4036,9 @@
 		return_error_line = __LINE__;
 		goto err_copy_data_failed;
 	}
